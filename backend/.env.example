# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=tradex_super_secret_jwt_key_2026
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# MongoDB Atlas Database Connection
# Format: mongodb+srv://<db_username>:<db_password>@<cluster_name>.xxxxx.mongodb.net/<database_name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://admin:your_secure_password@cluster0.xxxxx.mongodb.net/tradex_lms?retryWrites=true&w=majority

# Razorpay Payment Gateway Credentials
# Find these in Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay Webhook Secret
# Set this when creating a webhook in Razorpay Dashboard -> Settings -> Webhooks
# Webhook URL: https://your-domain.com/api/payments/webhook
# Events: order.paid, payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
